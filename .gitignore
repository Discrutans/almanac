# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Almanac server secrets (Yandex SA keys, prod env)
server/secrets/*.json
server/.env.yandex
server/data/*.db
server/data/*.json

# Local analysis / test dumps
/analyze_output.txt
/test_output.txt
/build-apk-log.txt
/test-results-*.txt

# Accidental npm leftovers
node_modules/
package-lock.json

# Android upload key (never commit)
android/key.properties
android/keystore/
