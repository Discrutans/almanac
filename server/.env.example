# Almanac Platform API — universal self-hosted config

# Copy to .env and adjust for your host (VPS, Yandex, Railway, home server, …)



ALMANAC_HOST=0.0.0.0

ALMANAC_PORT=8080



# Public URL clients use for deep links (/join/:token)

ALMANAC_PUBLIC_ORIGIN=https://api.example.com



# sqlite | ydb

ALMANAC_DB_BACKEND=sqlite

ALMANAC_SQLITE_PATH=./data/almanac.db



# YandexDB / any YDB endpoint (when ALMANAC_DB_BACKEND=ydb)

ALMANAC_YDB_ENDPOINT=grpc://localhost:2136

ALMANAC_YDB_DATABASE=/local

# ALMANAC_YDB_SERVICE_ACCOUNT_KEY_FILE=/secrets/sa-key.json



# Optional: Firebase Cloud Messaging for booking push (legacy HTTP API)

# ALMANAC_FCM_SERVER_KEY=



# App Links verification (serve /.well-known/* from this same host)

# ALMANAC_ANDROID_PACKAGE=com.example.almanac

# ALMANAC_ANDROID_SHA256_CERT=AA:BB:...

# ALMANAC_IOS_TEAM_ID=ABCDE12345

# ALMANAC_IOS_BUNDLE_ID=com.example.almanac



ALMANAC_CORS_ORIGINS=*

# Local PC helper: /lab (WireGuard) and /lab/plan (collaborative session playground).
# Only answers private/loopback clients. Do not enable on a public VPS.
# ALMANAC_HOME_LAB=1

