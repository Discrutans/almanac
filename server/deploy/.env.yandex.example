# Скопируйте в server/.env.yandex и заполните значения из консоли Yandex Cloud.
# НЕ коммитьте .env.yandex и sa-key.json в git!

ALMANAC_HOST=0.0.0.0
ALMANAC_PORT=8080

# Публичный URL API (HTTPS). Используется в deep links /join/:token
ALMANAC_PUBLIC_ORIGIN=https://api.example.com

# --- YandexDB ---
ALMANAC_DB_BACKEND=ydb

# Serverless YDB (рекомендуется для старта):
# ALMANAC_YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
# Dedicated YDB:
# ALMANAC_YDB_ENDPOINT=grpcs://ydb.example.yandexcloud.net:2135

ALMANAC_YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
ALMANAC_YDB_DATABASE=/ru-central1/b1gxxxxxxxxxx/etnxxxxxxxxxx

# JSON-ключ сервисного аккаунта (IAM → SA → ключ → JSON)
# Docker / Linux VM: /secrets/sa-key.json  (монтируется из ./secrets/sa-key.json)
# Windows без Docker: secrets\sa-key.json  (run_yandex.ps1 подставит путь сам)
ALMANAC_YDB_SERVICE_ACCOUNT_KEY_FILE=/secrets/sa-key.json

# --- App Links (optional) ---
# ALMANAC_ANDROID_PACKAGE=com.example.almanac
# ALMANAC_ANDROID_SHA256_CERT=AA:BB:...
# ALMANAC_IOS_TEAM_ID=ABCDE12345
# ALMANAC_IOS_BUNDLE_ID=com.example.almanac

# ALMANAC_FCM_SERVER_KEY=
ALMANAC_CORS_ORIGINS=*
