-- YandexDB schema for production deployment

CREATE TABLE workspaces (
  api_key Utf8 NOT NULL,
  profile_id Utf8 NOT NULL,
  name Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  PRIMARY KEY (api_key)
);

CREATE TABLE sessions (
  id Utf8 NOT NULL,
  token Utf8 NOT NULL,
  workspace_api_key Utf8 NOT NULL,
  profile_id Utf8 NOT NULL,
  mode Utf8 NOT NULL,
  title Utf8 NOT NULL,
  state_json JsonDocument NOT NULL,
  version Uint64 NOT NULL,
  status Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  PRIMARY KEY (id),
  INDEX sessions_by_token GLOBAL SYNC ON (token),
  INDEX sessions_by_workspace GLOBAL SYNC ON (workspace_api_key)
);

CREATE TABLE session_clients (
  session_id Utf8 NOT NULL,
  client_id Utf8 NOT NULL,
  display_name Utf8 NOT NULL,
  last_seen_at Timestamp NOT NULL,
  PRIMARY KEY (session_id, client_id)
);

CREATE TABLE booking_requests (
  id Utf8 NOT NULL,
  session_id Utf8 NOT NULL,
  slot_id Utf8 NOT NULL,
  fields_json JsonDocument NOT NULL,
  status Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  PRIMARY KEY (id),
  INDEX booking_requests_by_session GLOBAL SYNC ON (session_id)
);

CREATE TABLE calendar_snapshots (
  api_key Utf8 NOT NULL,
  profile_id Utf8 NOT NULL,
  snapshot_json JsonDocument NOT NULL,
  updated_at Timestamp NOT NULL,
  PRIMARY KEY (api_key, profile_id)
);

CREATE TABLE device_tokens (
  api_key Utf8 NOT NULL,
  token Utf8 NOT NULL,
  platform Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  PRIMARY KEY (api_key, token)
);

CREATE TABLE event_locks (
  api_key Utf8 NOT NULL,
  event_id Utf8 NOT NULL,
  device_id Utf8 NOT NULL,
  expires_at Timestamp NOT NULL,
  PRIMARY KEY (api_key, event_id)
);
